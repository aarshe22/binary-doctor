#!/usr/bin/env bash
set -euo pipefail

opencode_version="${OPENCODE_VERSION:-latest}"
rea_version="${REA_AGENTS_VERSION:-latest}"

echo "OpenCode before update: $(opencode --version 2>/dev/null || echo not-installed)"
echo "Updating opencode-ai@${opencode_version} and rea-agents@${rea_version}..."
npm install --global npm@latest
npm install --global --allow-scripts=opencode-ai "opencode-ai@${opencode_version}" "rea-agents@${rea_version}"
echo "OpenCode after update: $(opencode --version 2>/dev/null || echo not-installed)"
rea --version 2>/dev/null || true
