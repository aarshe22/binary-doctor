#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: analyze-ghidra /path/to/binary [project-name]" >&2
  exit 2
fi

target="$1"
project="${2:-$(basename "$target").ghidra}"
project_dir="/workspace/ghidra-projects"
mkdir -p "$project_dir"

exec "${GHIDRA_HEADLESS:-/opt/ghidra/support/analyzeHeadless}" \
  "$project_dir" "$project" \
  -import "$target" \
  -recursive \
  -overwrite \
  -analysisTimeoutPerFile 1800 \
  -log "/workspace/${project}.log" \
  -scriptlog "/workspace/${project}.script.log"
